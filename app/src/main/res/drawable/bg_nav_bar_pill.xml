<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_shadow" />
            <corners android:radius="@dimen/nav_bar_corner_radius" />
        </shape>
    </item>
    <!-- white pill -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_bg_white" />
            <corners android:radius="@dimen/nav_bar_corner_radius" />
        </shape>
    </item>
</layer-list>
