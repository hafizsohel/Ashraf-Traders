<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow Circle -->

    <item>

        <shape android:shape="oval">

            <size
                android:width="96dp"
                android:height="96dp"/>

            <solid
                android:color="#1AF44336"/>

        </shape>

    </item>

    <!-- Main Circle -->

    <item
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp">

        <shape android:shape="oval">

            <solid
                android:color="#FFF2F2"/>

        </shape>

    </item>

</layer-list>