<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="isStaff"
            type="Boolean" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/liquid_gradient_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/charcoal_l1"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@android:color/white"
                app:title="বিক্রয়"
                app:titleCentered="true"
                app:titleTextColor="@android:color/white" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="আজকের সারসংক্ষেপ:"
                            android:textColor="#222222"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layoutDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৩১ জুলাই, ২০২৬"
                                android:textColor="#666666"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivCalendar"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="#009688" />
                        </LinearLayout>
                    </RelativeLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="4dp">

                            <!-- মোট বিক্রয় -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/card_bg_sale"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/card_stroke_sale"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_nav_orders"
                                        app:tint="@color/card_icon_sale" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="মোট বিক্রয়"
                                            android:textColor="@color/text_sub"
                                            android:textSize="10sp" />

                                        <TextView
                                            android:id="@+id/tvTotalSale"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="৳ ১২,৪৫,০০০"
                                            android:textColor="@color/card_icon_sale"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- মোট অর্ডার -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/card_bg_list"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/card_stroke_list"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_sales_list"
                                        app:tint="@color/card_icon_list" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="মোট অর্ডার"
                                            android:textColor="@color/text_sub"
                                            android:textSize="10sp" />

                                        <TextView
                                            android:id="@+id/tvTotalOrder"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="১৮ টি"
                                            android:textColor="@color/card_icon_list"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- বকেয়া -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/card_bg_return"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/card_stroke_return"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_sales_return"
                                        app:tint="@color/card_icon_return" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="বকেয়া"
                                            android:textColor="@color/text_sub"
                                            android:textSize="10sp" />

                                        <TextView
                                            android:id="@+id/tvTotalDue"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="৳ ৮,৫০০০০"
                                            android:textColor="@color/card_icon_return"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- মোট লাভ -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="46dp"
                                app:cardBackgroundColor="@color/card_bg_due"
                                android:visibility="@{isStaff ? android.view.View.GONE : android.view.View.VISIBLE}"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/card_stroke_due"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="14dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_due_collection"
                                        app:tint="@color/card_icon_due" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="মোট লাভ"
                                            android:textColor="@color/text_sub"
                                            android:textSize="10sp" />

                                        <TextView
                                            android:id="@+id/tvTotalProfit"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="৳ ২,৩০০০"
                                            android:textColor="@color/card_icon_due"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                    </LinearLayout>

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="দ্রুত ব্যবস্থা:"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/quickActionsLayout"
                layout="@layout/item_quick_action" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="সাম্প্রতিক বিক্রয়:"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সব দেখুন"
                    android:textColor="#00897B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>