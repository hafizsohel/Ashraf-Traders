<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/login"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text="দোকানের তথ্য"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#EEF2F7"/>

        <!-- Shop Name -->

        <TextView
            android:text="🏪 দোকানের নাম"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvShopName"
            android:text="আশরাফ ট্রেডার্স"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Owner -->

        <TextView
            android:text="👤 মালিকের নাম"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvOwner"
            android:text="প্রোপাইটার মোহাম্মদ আশরাফুজ্জামান"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Mobile -->

        <TextView
            android:text="📱 মোবাইল নম্বর"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvMobile"
            android:text="+8801634-887078"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Email -->

        <TextView
            android:text="📝 বিবরণ"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvEmail"
            android:text="এক ছাদের নিচে মোটর, পাইপ, ফিটিংস, স্যানিটারি ও পানির ট্যাংকের বিশ্বস্ত সংগ্রহ।"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Address -->

        <TextView
            android:text="📍 ঠিকানা"
            android:textStyle="bold"
            android:textColor="#334155"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvAddress"
            android:text="কাটাখালি বাজার, চাটমোহর, পাবনা"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Buttons -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="বন্ধ করুন"
                android:textAllCaps="false"
                app:backgroundTint="#00695C"
                android:textColor="@color/white"/>


        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>